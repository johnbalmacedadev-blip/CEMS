# Copy to .env.deploy (gitignored) and fill in secrets.
# Usage: .\scripts\deploy-to-live.ps1

# Live site
LIVE_URL=https://carempireph.com/db-system
LIVE_BASE_PATH=/db-system
# Remote FTP folder relative to the FTP account home.
# If the FTP user is already jailed into public_html/db-system, leave as .
REMOTE_PATH=.

# FTP / explicit FTPS
FTP_HOST=carempireph.live
FTP_PORT=21
FTP_USER=admindatabase@carempireph.com
FTP_PASSWORD=
# Explicit FTPS (AUTH TLS). Set 0 only if host requires plain FTP.
FTP_SSL=1
# cPanel often uses a self-signed cert; 1 skips verification.
FTP_INSECURE=1

# Prefer SFTP when available (recommended; avoids FTP PASV firewall issues)
# Use the MAIN cPanel account (not always the FTP add-on user).
SFTP_HOST=carempireph.live
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# SFTP_KEY_PATH=

# Post-deploy artisan runner: https://carempireph.com/db-system/deploy/run?token=...
DEPLOY_TOKEN=

# Production .env values uploaded only when remote .env is missing (first deploy)
APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
